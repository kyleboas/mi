# Persistent Flue orchestrator. Optional; if unset, Mi uses the safe pi-backed fallback path.
FLUE_ENABLED=true
# Optional command/path. If empty, the adapter uses ./node_modules/.bin/flue when present, then PATH flue.
FLUE_CMD=
# Per-request Flue timeout in milliseconds.
FLUE_TIMEOUT_MS=30000
# Stable Flue conversation/session id for normal chat.
FLUE_CHAT_SESSION=mi-chat

# pi command and default models for chat fallback, read-only inspection, and workers.
PI_CMD=pi
PI_MODEL=openai-codex/gpt-5.5:low
PI_WORKER_MODEL=openai-codex/gpt-5.5:low

# Disabled by default because repair workers may edit files, create branches, run tests, and prepare PRs.
# Enable only behind approval gates.
PI_REPAIR_ENABLED=false

# Long-running local Flue server for persistent chat orchestration.
FLUE_URL=http://127.0.0.1:3583
FLUE_HOST=127.0.0.1
FLUE_PORT=3583

# Optional Pushover notifications. Leave blank to disable.
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Twilio voice is disabled unless explicitly enabled. Use an API key/secret at runtime;
# do not put live credentials in this file. Production requires a public HTTPS callback.
MI_TWILIO_ENABLED=false
MI_TWILIO_TOOL_ENABLED=false
MI_TWILIO_ENV=development
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Auth token is separate from the API key secret and validates X-Twilio-Signature.
TWILIO_AUTH_TOKEN=
MI_TWILIO_FROM_NUMBER=
MI_TWILIO_WEBHOOK_BASE_URL=https://voice.example.com
MI_TWILIO_ALLOWED_COUNTRY_CODES=1
MI_TWILIO_PROHIBITED_PREFIXES=+1900,+1976,+1979,+979
MI_TWILIO_ALLOWED_PREMIUM_PREFIXES=
MI_TWILIO_ALLOW_PREMIUM=false
MI_TWILIO_MAX_SCRIPT_CHARS=1200
MI_TWILIO_MAX_CALL_SECONDS=180
MI_TWILIO_CONFIRMATION_TTL_MS=300000
MI_TWILIO_MAX_CALLS_PER_USER=3
MI_TWILIO_MAX_CALLS_PER_NUMBER=2
MI_TWILIO_MAX_CALLS_PER_ACCOUNT=20
